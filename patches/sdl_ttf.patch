+// The pixel column a glyph is placed at: the nearest quarter pixel's for
+// subpixel rendering (see Render_Line_TextEngine), else the pixel below.
+static int Glyph_Pixel_X(const TTF_Font *font, int x)
+{
+    if (font->render_subpixel && !font->render_sdf) {
+        return FT_FLOOR(x + 8);
+    }
+    return FT_FLOOR(x);
+}
+
+// Whether a font's glyph images are rendered for LCD subpixels (TTF_SetFontLCD).
+static bool Glyph_Use_LCD(const TTF_Font *font)
+{
+    return font->lcd_order != 0 &&
+           !font->render_sdf &&
+           FT_IS_SCALABLE(font->face) &&
+           !FT_HAS_COLOR(font->face);
