+static void RenderSequence(SDL_Renderer *renderer, AtlasDrawSequence *sequence, const SDL_FColor *color)
+{
+    SDL_RenderGeometryRaw(renderer,
+                          sequence->texture,
+                          sequence->positions, 2 * sizeof(float),
+                          color, 0,
+                          sequence->texcoords, 2 * sizeof(float),
+                          sequence->num_rects * 4,
+                          sequence->indices, sequence->num_rects * 6, sizeof(*sequence->indices));
+}
+
+// Room for `more` rects in the LCD batch
+static bool GrowLCDBatch(LCDBatch *batch, int more)
+{
+    const int needed = batch->num_rects + more;
+    if (needed <= batch->max_rects) {
+        return true;
+    }
+
+    const int max_rects = SDL_max(needed, SDL_max(256, batch->max_rects * 2));
+    float *positions = (float *)SDL_realloc(batch->positions, max_rects * 8 * sizeof(float));
+    if (positions) {
+        batch->positions = positions;
+    }
+    float *texcoords = (float *)SDL_realloc(batch->texcoords, max_rects * 8 * sizeof(float));
+    if (texcoords) {
+        batch->texcoords = texcoords;
+    }
+    SDL_FColor *coverage = (SDL_FColor *)SDL_realloc(batch->coverage, max_rects * 4 * sizeof(SDL_FColor));
+    if (coverage) {
+        batch->coverage = coverage;
+    }
+    SDL_FColor *ink = (SDL_FColor *)SDL_realloc(batch->ink, max_rects * 4 * sizeof(SDL_FColor));
+    if (ink) {
+        batch->ink = ink;
+    }
+    SDL_FColor *color = (SDL_FColor *)SDL_realloc(batch->color, max_rects * 4 * sizeof(SDL_FColor));
+    if (color) {
+        batch->color = color;
+    }
+    int *indices = (int *)SDL_realloc(batch->indices, max_rects * 6 * sizeof(int));
+    if (indices) {
+        batch->indices = indices;
+    }
+    int *sorted = (int *)SDL_realloc(batch->sorted, max_rects * 6 * sizeof(int));
+    if (sorted) {
+        batch->sorted = sorted;
+    }
+    Uint8 *layers = (Uint8 *)SDL_realloc(batch->layers, max_rects * sizeof(Uint8));
+    if (layers) {
+        batch->layers = layers;
+    }
+    if (!positions || !texcoords || !coverage || !ink || !color || !indices || !sorted || !layers) {
+        return false;
+    }
+
+    batch->max_rects = max_rects;
+    return true;
+}
+
+// Sizes the LCD batch's grid to cover the render target, all tiles empty. Called while the
+// batch is empty. Rects partly outside the target are filed under its edge tiles.
+static bool ResetLCDGrid(TTF_RendererTextEngineData *data)
+{
+    LCDBatch *batch = &data->lcd;
+    int w = 0, h = 0;
+    SDL_GetCurrentRenderOutputSize(data->renderer, &w, &h);
+    batch->target_w = w;
+    batch->target_h = h;
+    const int grid_w = SDL_max((w + LCD_TILE_SIZE - 1) / LCD_TILE_SIZE, 1);
+    const int grid_h = SDL_max((h + LCD_TILE_SIZE - 1) / LCD_TILE_SIZE, 1);
+    if (batch->grid && grid_w == batch->grid_w && grid_h == batch->grid_h) {
+        return true;
+    }
+
+    int *grid = (int *)SDL_realloc(batch->grid, grid_w * grid_h * sizeof(int));
+    if (!grid) {
+        return false;
+    }
+    for (int i = 0; i < grid_w * grid_h; ++i) {
+        grid[i] = -1;
+    }
+    batch->grid = grid;
+    batch->grid_w = grid_w;
+    batch->grid_h = grid_h;
+    return true;
+}
+
+// A queued rect's box
+static void LCDRectBox(const LCDBatch *batch, int rect, float box[4])
+{
+    const float *p = batch->positions + rect * 8;
+    box[0] = p[0];  // left
+    box[1] = p[1];  // top
+    box[2] = p[4];  // right
+    box[3] = p[5];  // bottom
+}
+
+// The lowest layer of the LCD batch with no rect that overlaps `rect`, which is then filed
+// under the tiles it covers. Overlapping glyphs drawn in one pass would darken the target
+// and add their color twice where they overlap; in separate layers they compose as if
+// drawn one after the other, which for the same color is the same in either order. Where
+// glyphs of different colors overlap, a later one can be drawn first.
+static int LCDLayerFor(LCDBatch *batch, int rect)
+{
+    float box[4];
+    LCDRectBox(batch, rect, box);
+
+    // Wholly outside the target: nothing it overlaps can show (a long line's glyphs past
+    // the edge would otherwise pile up in the edge tiles)
+    const bool outside = box[2] <= 0.0f || box[3] <= 0.0f ||
+                         box[0] >= (float)batch->target_w || box[1] >= (float)batch->target_h;
+    if (outside) {
+        return 0;
+    }
+
+    const int tx0 = SDL_clamp((int)SDL_floorf(box[0] / LCD_TILE_SIZE), 0, batch->grid_w - 1);
+    const int ty0 = SDL_clamp((int)SDL_floorf(box[1] / LCD_TILE_SIZE), 0, batch->grid_h - 1);
+    const int tx1 = SDL_clamp((int)SDL_floorf(box[2] / LCD_TILE_SIZE), 0, batch->grid_w - 1);
+    const int ty1 = SDL_clamp((int)SDL_floorf(box[3] / LCD_TILE_SIZE), 0, batch->grid_h - 1);
+
+    // The layers of the rects it overlaps
+    Uint32 taken = 0;
+    for (int ty = ty0; ty <= ty1; ++ty) {
+        for (int tx = tx0; tx <= tx1; ++tx) {
+            for (int e = batch->grid[ty * batch->grid_w + tx]; e >= 0; e = batch->entries[e].next) {
+                float other[4];
+                LCDRectBox(batch, batch->entries[e].rect, other);
+                const bool overlaps = box[0] < other[2] && other[0] < box[2] &&
+                                      box[1] < other[3] && other[1] < box[3];
+                if (overlaps) {
+                    taken |= 1u << batch->layers[batch->entries[e].rect];
+                }
+            }
+        }
+    }
+
+    // The lowest free one (the last if all are taken: a pile of glyphs in one place)
+    int layer = 0;
+    while (layer < LCD_MAX_LAYERS - 1 && (taken & (1u << layer))) {
+        ++layer;
+    }
+
+    // Filed under its tiles
+    const int needed = batch->num_entries + (tx1 - tx0 + 1) * (ty1 - ty0 + 1);
+    if (needed > batch->max_entries) {
+        const int max_entries = SDL_max(needed, SDL_max(512, batch->max_entries * 2));
+        LCDTileEntry *entries = (LCDTileEntry *)SDL_realloc(batch->entries, max_entries * sizeof(LCDTileEntry));
+        if (!entries) {
+            return layer;
+        }
+        batch->entries = entries;
+        batch->max_entries = max_entries;
+    }
+    for (int ty = ty0; ty <= ty1; ++ty) {
+        for (int tx = tx0; tx <= tx1; ++tx) {
+            const int tile = ty * batch->grid_w + tx;
+            LCDTileEntry *entry = &batch->entries[batch->num_entries];
+            entry->rect = rect;
+            entry->tile = tile;
+            entry->next = batch->grid[tile];
+            batch->grid[tile] = batch->num_entries++;
+        }
+    }
+    return layer;
+}
+
+// Queues a sequence of LCD glyphs, placed (its positions filled in), in the text's color
+static void QueueLCDSequence(TTF_RendererTextEngineData *data, AtlasDrawSequence *sequence, const SDL_FColor *color)
+{
+    LCDBatch *batch = &data->lcd;
+    if (batch->texture != sequence->texture) {
+        FlushLCDBatch(data);
+        batch->texture = sequence->texture;
+    }
+    if (batch->num_rects == 0 && !ResetLCDGrid(data)) {
+        RenderSequence(data->renderer, sequence, color);
+        return;
+    }
+    if (!GrowLCDBatch(batch, sequence->num_rects)) {
+        RenderSequence(data->renderer, sequence, color);
+        return;
+    }
+
+    const int first = batch->num_rects;
+    const int count = sequence->num_rects;
+    SDL_memcpy(batch->positions + first * 8, sequence->positions, count * 8 * sizeof(float));
+    SDL_memcpy(batch->texcoords + first * 8, sequence->texcoords, count * 8 * sizeof(float));
+
+    const SDL_FColor coverage = { color->a, color->a, color->a, color->a };
+    const SDL_FColor ink = { color->r * color->a, color->g * color->a, color->b * color->a, color->a };
+    for (int i = first * 4; i < (first + count) * 4; ++i) {
+        batch->coverage[i] = coverage;
+        batch->ink[i] = ink;
+        batch->color[i] = *color;
+    }
+
+    static const Uint8 rect_index_order[] = { 0, 1, 2, 0, 2, 3 };
+    int *indices = batch->indices + first * 6;
+    for (int i = first; i < first + count; ++i) {
+        for (int k = 0; k < 6; ++k) {
+            *indices++ = i * 4 + rect_index_order[k];
+        }
+    }
+    for (int i = first; i < first + count; ++i) {
+        const int layer = LCDLayerFor(batch, i);
+        batch->layers[i] = (Uint8)layer;
+        batch->num_layers = SDL_max(batch->num_layers, layer + 1);
+    }
+    batch->num_rects += count;
+}
+
+// Draws the queued rects whose indices are `indices` (`num_indices` of them) in `colors`
+static void RenderLCDBatch(TTF_RendererTextEngineData *data, const SDL_FColor *colors, const int *indices, int num_indices)
+{
+    LCDBatch *batch = &data->lcd;
+    SDL_RenderGeometryRaw(data->renderer,
+                          batch->texture,
+                          batch->positions, 2 * sizeof(float),
+                          colors, sizeof(SDL_FColor),
+                          batch->texcoords, 2 * sizeof(float),
+                          batch->num_rects * 4,
+                          indices, num_indices, sizeof(*indices));
+}
+
+// Fills the batch's sorted indices with its rects' indices by layer; `starts` gets where
+// each layer's begin, and one past the last
+static void SortLCDBatch(LCDBatch *batch, int starts[LCD_MAX_LAYERS + 1])
+{
+    int counts[LCD_MAX_LAYERS] = { 0 };
+    for (int i = 0; i < batch->num_rects; ++i) {
+        counts[batch->layers[i]] += 6;
+    }
+
+    starts[0] = 0;
+    for (int layer = 0; layer < LCD_MAX_LAYERS; ++layer) {
+        starts[layer + 1] = starts[layer] + counts[layer];
+    }
+
+    int next[LCD_MAX_LAYERS];
+    SDL_memcpy(next, starts, sizeof(next));
+    for (int i = 0; i < batch->num_rects; ++i) {
+        SDL_memcpy(batch->sorted + next[batch->layers[i]], batch->indices + i * 6, 6 * sizeof(int));
+        next[batch->layers[i]] += 6;
+    }
+}
+
+// Empties the LCD batch, and the grid tiles its rects were filed under
+static void ClearLCDBatch(LCDBatch *batch)
+{
+    for (int e = 0; e < batch->num_entries; ++e) {
+        batch->grid[batch->entries[e].tile] = -1;
+    }
+    batch->num_entries = 0;
+    batch->num_rects = 0;
+    batch->num_layers = 0;
+    batch->texture = NULL;
+}
+
+// Draws the queued LCD glyphs, whose color channels are each subpixel's coverage, onto an
+// opaque target: the target darkened by the coverage, then the color added by it, each
+// channel on its own (target * (1 - coverage) + color * coverage). Without custom blend
+// modes they are blended by their alpha, the brightest subpixel. Each layer is drawn in
+// both passes before the next, so overlapping glyphs aren't drawn in the same pass.
+static void FlushLCDBatch(TTF_RendererTextEngineData *data)
+{
+    LCDBatch *batch = &data->lcd;
+    if (batch->num_rects == 0) {
+        ClearLCDBatch(batch);
+        return;
+    }
+
+    const SDL_BlendMode cover = SDL_ComposeCustomBlendMode(
+        SDL_BLENDFACTOR_ZERO, SDL_BLENDFACTOR_ONE_MINUS_SRC_COLOR, SDL_BLENDOPERATION_ADD,
+        SDL_BLENDFACTOR_ZERO, SDL_BLENDFACTOR_ONE, SDL_BLENDOPERATION_ADD);
+    const SDL_BlendMode ink = SDL_ComposeCustomBlendMode(
+        SDL_BLENDFACTOR_ONE, SDL_BLENDFACTOR_ONE, SDL_BLENDOPERATION_ADD,
+        SDL_BLENDFACTOR_ZERO, SDL_BLENDFACTOR_ONE, SDL_BLENDOPERATION_ADD);
+
+    SDL_BlendMode old = SDL_BLENDMODE_BLEND;
+    SDL_GetTextureBlendMode(batch->texture, &old);
+    if (SDL_SetTextureBlendMode(batch->texture, cover)) {
+        int starts[LCD_MAX_LAYERS + 1];
+        SortLCDBatch(batch, starts);
+        for (int layer = 0; layer < batch->num_layers; ++layer) {
+            const int *indices = batch->sorted + starts[layer];
+            const int num_indices = starts[layer + 1] - starts[layer];
+            if (num_indices == 0) {
+                continue;
+            }
+
+            SDL_SetTextureBlendMode(batch->texture, cover);
+            RenderLCDBatch(data, batch->coverage, indices, num_indices);
+            SDL_SetTextureBlendMode(batch->texture, ink);
+            RenderLCDBatch(data, batch->ink, indices, num_indices);
+        }
+        SDL_SetTextureBlendMode(batch->texture, old);
+    } else {
+        RenderLCDBatch(data, batch->color, batch->indices, batch->num_rects * 6);
+    }
+
+    ClearLCDBatch(batch);
+}
+
+bool TTF_FlushRendererText(TTF_TextEngine *engine)
+{
+    if (!engine || engine->CreateText != CreateText) {
+        return SDL_InvalidParamError("engine");
+    }
+
+    FlushLCDBatch((TTF_RendererTextEngineData *)engine->userdata);
+    return true;
+}
