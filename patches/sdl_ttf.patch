+bool TTF_SetFontCoverageTable(TTF_Font *font, const Uint8 *table)
+{
+    TTF_CHECK_FONT(font, false);
+    font->use_coverage_table = (table != NULL);
+    if (table) {
+        SDL_memcpy(font->coverage_table, table, sizeof(font->coverage_table));
+    }
+    return true;
