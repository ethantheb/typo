     return blendState;
 }
 
+// Whether the swap chain uses the blit model (transparent windows, or asked for)
+static bool D3D11_UseBlitModel(SDL_Renderer *renderer)
+{
+    if (SDL_GetWindowFlags(renderer->window) & SDL_WINDOW_TRANSPARENT) {
+        return true;
+    }
+    return SDL_GetHintBoolean(SDL_HINT_RENDER_DIRECT3D11_BLIT_MODEL, false);
+}
