diff --git a/src/terminal/page.zig b/src/terminal/page.zig
index ad2b1a7e5..78a3eb491 100644
--- a/src/terminal/page.zig
+++ b/src/terminal/page.zig
@@ -2368,6 +2368,19 @@ pub const Cell = packed struct(u64) {
         };
     }
 
+    /// Returns true if the cell shows nothing but its background: a narrow
+    /// space, or a cell with only a background color.
+    pub fn isBlankSpace(self: Cell) bool {
+        if (self.wide != .narrow) return false;
+        return switch (self.content_tag) {
+            .codepoint => self.content.codepoint.data == ' ',
+            .codepoint_grapheme => false,
+            .bg_color_palette,
+            .bg_color_rgb,
+            => true,
+        };
+    }
+
     pub inline fn hasGrapheme(self: Cell) bool {
         return self.content_tag == .codepoint_grapheme;
     }
